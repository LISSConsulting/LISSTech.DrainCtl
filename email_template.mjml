<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Segoe UI', -apple-system, 'Helvetica Neue', Arial, sans-serif" />
      <mj-text line-height="1.4" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#fdf8f6" width="520px">
    <mj-section padding="16px" text-align="left">
      <mj-column background-color="{{.CardBg}}" border-left="5px solid {{.BorderColor}}" border="2.5px solid #2d1a1a" border-radius="10px" inner-background-color="{{.CardBg}}" padding="0" css-class="card-brutal">

        <!-- Header -->
        <mj-text padding="24px 28px 4px 28px" font-size="11px" font-weight="700" letter-spacing="0.12em" text-transform="uppercase" color="{{.BorderColor}}">
          DrainCtl
        </mj-text>
        <mj-text padding="0 28px 14px 28px" font-size="18px" font-weight="700" color="#2d1a1a" line-height="1.3">
          {{.Subject}}
        </mj-text>
        <mj-divider border-color="#2d1a1a" border-width="1.5px" padding="0 28px 16px 28px" />

        <!-- Status badge (table-cell for Outlook Classic padding support) -->
        <mj-text padding="0 28px 16px 28px">
          <table cellpadding="0" cellspacing="0" border="0" role="presentation"><tr>
            <td style="background-color:{{.StatusColor}};color:#ffffff;font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:5px 14px;border:2px solid #2d1a1a;mso-padding-alt:5px 14px;">{{.Status}}</td>
          </tr></table>
        </mj-text>

        <!-- Details table -->
        <mj-table padding="0 28px 16px 28px" cellpadding="0" cellspacing="0" width="100%" css-class="detail-table">
          <tr style="background-color:#f5ebe8;">
            <td style="padding:9px 14px;font-size:11px;font-weight:700;color:#7a5a5a;width:36%;text-transform:uppercase;letter-spacing:0.06em;border-bottom:1px solid #d5c5c0;">Server</td>
            <td style="padding:9px 14px;font-size:14px;color:#2d1a1a;font-weight:600;border-bottom:1px solid #d5c5c0;">{{.Host}}</td>
          </tr>
          <tr>
            <td style="padding:9px 14px;font-size:11px;font-weight:700;color:#7a5a5a;text-transform:uppercase;letter-spacing:0.06em;border-bottom:1px solid #d5c5c0;">Mode</td>
            <td style="padding:9px 14px;font-size:14px;color:#2d1a1a;border-bottom:1px solid #d5c5c0;">{{.Mode}}</td>
          </tr>
          <tr style="background-color:#f5ebe8;">
            <td style="padding:9px 14px;font-size:11px;font-weight:700;color:#7a5a5a;text-transform:uppercase;letter-spacing:0.06em;border-bottom:1px solid #d5c5c0;">Status</td>
            <td style="padding:9px 14px;font-size:14px;color:#2d1a1a;border-bottom:1px solid #d5c5c0;">{{.Status}}</td>
          </tr>
          {{if .IsDrain}}{{if .Duration}}
          <tr>
            <td style="padding:9px 14px;font-size:11px;font-weight:700;color:#7a5a5a;text-transform:uppercase;letter-spacing:0.06em;border-bottom:1px solid #d5c5c0;">Duration</td>
            <td style="padding:9px 14px;font-size:14px;color:#2d1a1a;border-bottom:1px solid #d5c5c0;">{{.Duration}}</td>
          </tr>
          {{end}}{{if .GracePeriod}}
          <tr style="background-color:#f5ebe8;">
            <td style="padding:9px 14px;font-size:11px;font-weight:700;color:#7a5a5a;text-transform:uppercase;letter-spacing:0.06em;border-bottom:1px solid #d5c5c0;">Grace Period</td>
            <td style="padding:9px 14px;font-size:14px;color:#2d1a1a;border-bottom:1px solid #d5c5c0;">{{.GracePeriod}}</td>
          </tr>
          {{end}}
          <tr>
            <td style="padding:9px 14px;font-size:11px;font-weight:700;color:#7a5a5a;text-transform:uppercase;letter-spacing:0.06em;border-bottom:1px solid #d5c5c0;">Changed By</td>
            <td style="padding:9px 14px;font-size:14px;color:#2d1a1a;border-bottom:1px solid #d5c5c0;">{{.ChangedBy}}</td>
          </tr>
          {{end}}
          <tr style="background-color:#f5ebe8;">
            <td style="padding:9px 14px;font-size:11px;font-weight:700;color:#7a5a5a;text-transform:uppercase;letter-spacing:0.06em;">Timestamp</td>
            <td style="padding:9px 14px;font-size:14px;color:#2d1a1a;">{{.Timestamp}}</td>
          </tr>
        </mj-table>

        <!-- Message blockquote (conditional) -->
        <mj-text padding="0 28px 20px 28px">
          {{if .Message}}
          <div style="border-left:3px solid {{.BorderColor}};padding:10px 14px;background-color:{{.BlockquoteBg}};">
            <p style="margin:0;font-size:14px;color:#2d1a1a;line-height:1.5;font-style:italic;">{{.Message}}</p>
          </div>
          {{end}}
        </mj-text>

        <!-- Footer -->
        <mj-divider border-color="#d5c5c0" border-width="1.5px" padding="0 28px" />
        <mj-text padding="14px 28px 18px 28px" font-size="11px">
          <span style="font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:{{.BorderColor}};">LISSTech DrainCtl</span>
          <span style="color:#a68e8e;"> &middot; </span>
          <span style="font-size:10px;color:#a68e8e;">LISS Technologies</span>
          <!--[if mso]>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<![endif]-->
          <span style="float:right;font-size:10px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#7a5a5a;background-color:#f5ebe8;padding:2px 8px;border:1.5px solid #d5c5c0;">{{.Trigger}}</span>
        </mj-text>

      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
