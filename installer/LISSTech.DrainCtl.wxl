<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl"
    Culture="en-US">
    <String Id="DowngradeError"
        Value="A newer version of [ProductName] is already installed." />

    <!-- Welcome dialog -->
    <String Id="WelcomeDlgDescription"
        Value="The Setup Wizard will install [ProductName] v[ProductVersion] on your computer. Click Next to continue or Cancel to exit the Setup Wizard." />

    <!-- InstallModeDlg -->
    <String Id="InstallModeDlg_Title" Value="[ProductName] Setup" />
    <String Id="InstallModeDlgTitle"
        Value="{\WixUI_Font_Title}Install Mode" />
    <String Id="InstallModeDlgDescription"
        Value="Choose how this machine participates in the monitoring network." />
    <String Id="InstallModeDlgModeLabel" Value="Install mode:" />

    <!-- MonitoringDlg -->
    <String Id="MonitoringDlg_Title" Value="[ProductName] Setup" />
    <String Id="MonitoringDlgTitle"
        Value="{\WixUI_Font_Title}Monitoring Settings" />
    <String Id="MonitoringDlgDescription"
        Value="Configure monitoring intervals and performance collection." />
    <String Id="MonitoringDlgGraceLabel" Value="Grace period:" />
    <String Id="MonitoringDlgGraceHint" Value="minutes (1–1440)" />
    <String Id="MonitoringDlgPollLabel" Value="Poll interval:" />
    <String Id="MonitoringDlgPollHint" Value="seconds (minimum 10)" />
    <String Id="MonitoringDlgThresholdLabel" Value="Session warning threshold:" />
    <String Id="MonitoringDlgThresholdHint" Value="percent (0 = disabled)" />
    <String Id="MonitoringDlgPerfLabel" Value="Enable performance monitoring" />
    <String Id="MonitoringDlgRfxLabel" Value="Collect RemoteFX metrics" />

    <!-- NotificationsDlg -->
    <String Id="NotificationsDlg_Title" Value="[ProductName] Setup" />
    <String Id="NotificationsDlgTitle"
        Value="{\WixUI_Font_Title}Notification Settings" />
    <String Id="NotificationsDlgDescription"
        Value="Configure optional notification endpoints." />
    <String Id="NotificationsDlgWebhookLabel" Value="Webhook URL (optional):" />
    <String Id="NotificationsDlgNtfyLabel" Value="ntfy URL (optional):" />

    <!-- ModeConfigDlg (shared) -->
    <String Id="ModeConfigDlg_Title" Value="[ProductName] Setup" />
    <String Id="ModeConfigDlgPortLabel" Value="Dashboard listen port:" />
    <String Id="ModeConfigDlgGroupLabel" Value="Active Directory group allowed to access the dashboard:" />
    <String Id="ModeConfigDlgDashUrlLabel"
        Value="URL of the dashboard server this machine should register with:" />

    <!-- DashboardConfigDlg -->
    <String Id="DashboardConfigDlgTitle"
        Value="{\WixUI_Font_Title}Dashboard Configuration" />
    <String Id="DashboardConfigDlgDescription"
        Value="Configure the dashboard server settings." />

    <!-- RegistrationConfigDlg -->
    <String Id="RegistrationConfigDlgTitle"
        Value="{\WixUI_Font_Title}Dashboard Registration" />
    <String Id="RegistrationConfigDlgDescription"
        Value="Configure how this machine finds and registers with a dashboard server." />
    <String Id="RegistrationConfigDlgAutoDiscoverLabel"
        Value="Use DNS auto-discovery (recommended)" />
    <String Id="RegistrationConfigDlgAutoDiscoverHint"
        Value="Automatically find the dashboard server using DNS SRV records (_drainctl._tcp)." />
</WixLocalization>
