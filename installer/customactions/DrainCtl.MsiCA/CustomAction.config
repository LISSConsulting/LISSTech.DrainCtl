<?xml version="1.0" encoding="utf-8"?>
<!--
  SFXCA host config for the managed C# custom action.

  Without this file, MakeSfxCA bundles the assembly with WiX DTF's default
  CLR 2.0 host. SFXCA then tries to load our net472 assembly under CLR 2 and
  fails with BadImageFormatException ("This assembly is built by a runtime
  newer than the currently loaded runtime"), so the very first deferred CA
  (ApplyInstallerConfig) returns 1603, the InstallFinalize script aborts,
  and every later deferred CA — RegisterETWProvider, AddEventLogReaders,
  StartDrainCtlService, RegisterDiagsTask — silently never runs.

  useLegacyV2RuntimeActivationPolicy=true is harmless when no v2 mixed-mode
  assemblies are loaded but lets MakeSfxCA's own host activate cleanly on
  hosts that have legacy CLR shims registered.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
  </startup>
</configuration>
