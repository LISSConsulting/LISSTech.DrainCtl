  <String Id="HelpText" Value="/install | /repair | /uninstall - installs, repairs, or uninstalls.&#xA;&#xA;/passive | /quiet - displays minimal UI or no UI.&#xA;&#xA;/norestart - suppress restart prompts.&#xA;/log log.txt - logs to a specific file.&#xA;&#xA;Configuration properties:&#xA;  InstallMode=dashboard|registration|standalone&#xA;  WebhookUrl=https://hooks.example.com/...&#xA;  NtfyUrl=https://ntfy.sh/alerts&#xA;  DashboardUrl=https://dashboard:49470&#xA;  DashboardPort=49470&#xA;  DashboardGroup=Domain Admins&#xA;  GracePeriod=60" />
