<?xml version="1.0" encoding="utf-8"?>
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
    <Font Id="0" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="1" Height="-24" Weight="500" Foreground="windowtext">Segoe UI</Font>
    <Font Id="2" Height="-18" Weight="500" Foreground="555555">Segoe UI</Font>
    <Font Id="3" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="4" Height="-12" Weight="500" Foreground="windowtext">Consolas</Font>

    <Window Width="520" Height="380" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)" IconFile="icon.ico">
        <Label X="0" Y="0" Width="520" Height="80" />
        <ImageControl X="-11" Y="11" Width="64" Height="64" ImageFile="logo.png" Visible="yes"/>
        <Label X="11" Y="11" Width="-75" Height="64" FontId="1" Visible="yes" DisablePrefix="yes">#(loc.Title)</Label>
        <Label X="11" Y="42" Width="-75" Height="14" FontId="4" Visible="yes" DisablePrefix="yes">[WixBundleManufacturer]</Label>
        <Label Name="InstallVersion" X="11" Y="-11" Width="-251" Height="17" FontId="4" DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>

        <Page Name="Help">
            <Label X="11" Y="91" Width="-11" Height="30" FontId="2" DisablePrefix="yes">#(loc.HelpHeader)</Label>
            <Label X="11" Y="123" Width="-11" Height="-35" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
            <Button Name="HelpCloseButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.HelpCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Loading">
            <Label X="11" Y="91" Width="-11" Height="30" FontId="2" DisablePrefix="yes" Visible="no" Name="CheckingForUpdatesLabel" />
        </Page>

        <Page Name="Install">
            <Richedit Name="EulaRichedit" X="11" Y="91" Width="-11" Height="-70" TabStop="yes" FontId="0" HexStyle="800000" />
            <Checkbox Name="EulaAcceptCheckbox" X="-11" Y="-41" Width="260" Height="17" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
            <Button Name="OptionsButton" X="-171" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" VisibleCondition="NOT WixStdBASuppressOptionsUI">
                <Text>#(loc.InstallOptionsButton)</Text>
                <ChangePageAction Page="Options" />
            </Button>
            <Button Name="InstallButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
            <Button Name="InstallCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.InstallCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Options">
            <Label X="11" Y="91" Width="-11" Height="30" FontId="2" DisablePrefix="yes">#(loc.OptionsHeader)</Label>

            <!-- Install Mode -->
            <Label X="11" Y="122" Width="100" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsModeLabel)</Label>
            <Editbox Name="InstallMode" X="115" Y="120" Width="-11" Height="21" TabStop="yes" FontId="4" />
            <Label X="11" Y="146" Width="-11" Height="14" FontId="3" DisablePrefix="yes">#(loc.OptionsModeHint)</Label>

            <!-- Dashboard URL (registration mode) -->
            <Label X="11" Y="170" Width="100" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsDashUrlLabel)</Label>
            <Editbox Name="DashboardUrl" X="115" Y="168" Width="-11" Height="21" TabStop="yes" FontId="4" />

            <!-- Dashboard Port (dashboard mode) -->
            <Label X="11" Y="198" Width="100" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsDashPortLabel)</Label>
            <Editbox Name="DashboardPort" X="115" Y="196" Width="80" Height="21" TabStop="yes" FontId="4" />

            <!-- Dashboard Group (dashboard mode) -->
            <Label X="230" Y="198" Width="75" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsDashGroupLabel)</Label>
            <Editbox Name="DashboardGroup" X="310" Y="196" Width="-11" Height="21" TabStop="yes" FontId="4" />

            <!-- Webhook URL -->
            <Label X="11" Y="226" Width="100" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsWebhookLabel)</Label>
            <Editbox Name="WebhookUrl" X="115" Y="224" Width="-11" Height="21" TabStop="yes" FontId="4" />

            <!-- ntfy URL -->
            <Label X="11" Y="254" Width="100" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsNtfyLabel)</Label>
            <Editbox Name="NtfyUrl" X="115" Y="252" Width="-11" Height="21" TabStop="yes" FontId="4" />

            <!-- Grace Period -->
            <Label X="11" Y="282" Width="100" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsGraceLabel)</Label>
            <Editbox Name="GracePeriod" X="115" Y="280" Width="80" Height="21" TabStop="yes" FontId="4" />
            <Label X="200" Y="282" Width="120" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsGraceHint)</Label>

            <Button Name="OptionsOkButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsOkButton)</Text>
                <ChangePageAction Page="Install" />
            </Button>
            <Button Name="OptionsCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsCancelButton)</Text>
                <ChangePageAction Page="Install" Cancel="yes" />
            </Button>
        </Page>

        <Page Name="Progress">
            <Label X="11" Y="91" Width="-11" Height="30" FontId="2" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
            <Label X="11" Y="120" Width="70" Height="17" FontId="3" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
            <Label Name="OverallProgressPackageText" X="85" Y="120" Width="-11" Height="17" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="11" Y="142" Width="-11" Height="15" />
            <Button Name="ProgressCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
        </Page>

        <Page Name="Modify">
            <Label X="11" Y="91" Width="-11" Height="30" FontId="2" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
            <Label X="11" Y="120" Width="-11" Height="50" FontId="3" DisablePrefix="yes">#(loc.ModifyDescription)</Label>
            <Button Name="RepairButton" X="-171" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
            <Button Name="UninstallButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
            <Button Name="ModifyCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.ModifyCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Success">
            <Label X="11" Y="91" Width="-11" Height="30" FontId="2" DisablePrefix="yes">
                <Text>#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
            </Label>
            <Label X="11" Y="120" Width="-11" Height="60" FontId="3" DisablePrefix="yes">#(loc.SuccessDescription)</Label>
            <Label X="-11" Y="-51" Width="400" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.SuccessRestartText)</Label>
            <Button Name="SuccessRestartButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
            <Button Name="SuccessCloseButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.SuccessCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Failure">
            <Label X="11" Y="91" Width="-11" Height="30" FontId="2" DisablePrefix="yes">
                <Text>#(loc.FailureHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.FailureInstallHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
            </Label>
            <Hypertext Name="FailureLogFileLink" X="11" Y="132" Width="-11" Height="42" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
            <Hypertext Name="FailureMessageText" X="22" Y="174" Width="-11" Height="51" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
            <Label X="-11" Y="-51" Width="400" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
            <Button Name="FailureRestartButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
            <Button Name="FailureCloseButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.FailureCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
    </Window>
</Theme>
