<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="LISSTech DrainCtl"
        Manufacturer="LISS Consulting, Corp."
        Version="26.93.9"
        UpgradeCode="c7a1e3f0-5d28-4b91-a6e4-9f2c8d1b7a3e"
        Scope="perMachine">

        <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />

        <!-- Hide from Programs and Features -->
        <Property Id="ARPSYSTEMCOMPONENT" Value="1" />

        <!--
            Prevent Restart Manager from cascading service shutdowns during uninstall.
            The Event Log service holds drainctl-msg.dll loaded (via EventMessageFile),
            so RM tries to stop EventLog + all its dependents just to release a file lock.
            Our own ServiceControl handles DrainCtl; if the msg DLL is still locked,
            Windows Installer schedules it for deletion on reboot automatically.
        -->
        <SetProperty Id="MSIRMSHUTDOWN" Value="2" Before="InstallValidate"
            Sequence="execute" Condition="REMOVE=&quot;ALL&quot;" />

        <Media Id="1"
            Cabinet="LISSTech.DrainCtl.cab"
            EmbedCab="yes" />

        <Feature Id="Main">
            <ComponentGroupRef Id="AllComponents" />
        </Feature>
    </Package>

    <!-- ── Binaries + Service: Program Files\LISS Technologies\LISSTech DrainCtl\bin ── -->
    <Fragment>
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="LISSTechFolder" Name="LISS Technologies">
                <Directory Id="INSTALLFOLDER" Name="LISSTech DrainCtl">
                    <Directory Id="BinFolder" Name="bin" />
                </Directory>
            </Directory>
        </StandardDirectory>

        <!-- drainctl.exe: CLI + service binary, PATH entry -->
        <Component Id="MainExe" Directory="BinFolder"
            Guid="d4e2f1a0-8c37-4b5e-9d6a-1f3c7e2b8a4d">
            <File Id="drainctl.exe"
                Source="..\dist\LISSTech.DrainCtl\bin\drainctl.exe"
                KeyPath="yes" />
            <Environment Id="PATH"
                Name="PATH"
                Value="[BinFolder]"
                Permanent="no"
                Part="last"
                Action="set"
                System="yes" />
            <ServiceInstall Id="DrainCtlService"
                Name="DrainCtl"
                DisplayName="Remote Desktop Drain Mode Monitor"
                Description="Monitors Remote Desktop Session Host drain mode (TSServerDrainMode) and maintains an audit trail of state changes."
                Type="ownProcess"
                Start="auto"
                ErrorControl="normal"
                Arguments="service run"
                Account="LocalSystem" />
            <ServiceControl Id="DrainCtlServiceControl"
                Name="DrainCtl"
                Start="install"
                Stop="both"
                Remove="uninstall"
                Wait="yes" />
        </Component>

        <!-- drainctl.dll: P/Invoke target for PS module loaded from bin/ -->
        <Component Id="MainDll" Directory="BinFolder"
            Guid="5e6ed7b5-73a2-4ed3-ae86-ae1e9eade61c">
            <File Id="drainctl.dll"
                Source="..\dist\LISSTech.DrainCtl\bin\drainctl.dll"
                KeyPath="yes" />
        </Component>

        <!-- Event Log message file + source registration -->
        <Component Id="EventLogSource" Directory="BinFolder"
            Guid="6d88631f-f074-4125-9399-28a349a45bea">
            <File Id="drainctl_msg.dll"
                Source="..\assets\drainctl-msg.dll"
                Name="drainctl-msg.dll"
                KeyPath="yes" />
            <RegistryKey Root="HKLM"
                Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\DrainCtl">
                <RegistryValue Name="EventMessageFile" Type="string"
                    Value="[BinFolder]drainctl-msg.dll" />
                <RegistryValue Name="TypesSupported" Type="integer" Value="7" />
            </RegistryKey>
        </Component>
    </Fragment>

    <!-- ── ProgramData: LISS Technologies\LISSTech DrainCtl ────────────────── -->
    <Fragment>
        <StandardDirectory Id="CommonAppDataFolder">
            <Directory Id="ProgramDataLISSTech" Name="LISS Technologies">
                <Directory Id="DATADIRECTORY" Name="LISSTech DrainCtl" />
            </Directory>
        </StandardDirectory>

        <Component Id="DataDirectory" Directory="DATADIRECTORY"
            Guid="0c2afad8-e85a-4a79-b484-d3e51ebd6fea">
            <CreateFolder>
                <Permission User="SYSTEM" GenericAll="yes" />
                <Permission User="Administrators" GenericAll="yes" />
                <Permission User="Users" GenericRead="yes" GenericExecute="yes" />
            </CreateFolder>
        </Component>
    </Fragment>

    <!-- ── PowerShell Module: WindowsPowerShell\Modules\LISSTech.DrainCtl ── -->
    <Fragment>
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="WindowsPowerShellFolder" Name="WindowsPowerShell">
                <Directory Id="PSModulesFolder" Name="Modules">
                    <Directory Id="DrainCtlModuleFolder" Name="LISSTech.DrainCtl" />
                </Directory>
            </Directory>
        </StandardDirectory>

        <Component Id="PSModule" Directory="DrainCtlModuleFolder"
            Guid="cef702c3-0c59-4e9a-99c7-cd196ab5db23">
            <File Id="DrainCtl.psd1"
                Source="..\dist\LISSTech.DrainCtl\LISSTech.DrainCtl.psd1"
                KeyPath="yes" />
            <File Id="DrainCtl.psm1"
                Source="..\dist\LISSTech.DrainCtl\LISSTech.DrainCtl.psm1" />
            <File Id="drainctl_ps.dll"
                Source="..\dist\LISSTech.DrainCtl\bin\drainctl.dll"
                Name="drainctl.dll" />
        </Component>
    </Fragment>

    <!-- ── Default config.json in ProgramData ──────────────────────────────── -->
    <Fragment>
        <Component Id="DefaultConfig" Directory="DATADIRECTORY"
            Guid="39697d17-5164-472b-8a1e-533e93d4e4c9"
            NeverOverwrite="yes">
            <File Id="config.json"
                Source="config.json"
                KeyPath="yes" />
        </Component>
    </Fragment>

    <!-- ── Component Group ─────────────────────────────────────────────────── -->
    <Fragment>
        <ComponentGroup Id="AllComponents">
            <ComponentRef Id="MainExe" />
            <ComponentRef Id="MainDll" />
            <ComponentRef Id="EventLogSource" />
            <ComponentRef Id="DefaultConfig" />
            <ComponentRef Id="DataDirectory" />
            <ComponentRef Id="PSModule" />
        </ComponentGroup>
    </Fragment>
</Wix>
