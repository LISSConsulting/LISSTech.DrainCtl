<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
  xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
    <Package Name="LISSTech DrainCtl v$(var.ProductVersion)"
        Manufacturer="LISS Consulting, Corp."
        Version="$(var.ProductVersion)"
        UpgradeCode="c7a1e3f0-5d28-4b91-a6e4-9f2c8d1b7a3e"
        Scope="perMachine">

        <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)"
            Schedule="afterInstallExecute" />

        <Icon Id="AppIcon.ico" SourceFile="resources\appicon.ico" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
        <Property Id="ARPHELPLINK" Value="https://lissconsulting.github.io/LISSTech.DrainCtl/guide.html" />
        <Property Id="ARPURLINFOABOUT" Value="https://lissconsulting.github.io/LISSTech.DrainCtl/" />
        <Property Id="ARPURLUPDATEINFO" Value="https://github.com/LISSConsulting/LISSTech.DrainCtl/releases" />
        <Property Id="ARPCOMMENTS" Value="Remote Desktop Session Host drain mode monitoring with real-time dashboard, performance alerts, and multi-target notifications." />

        <SetProperty Id="MSIRMSHUTDOWN" Value="2" Before="InstallValidate"
            Sequence="execute" Condition="REMOVE=&quot;ALL&quot;" />

        <Media Id="1"
            Cabinet="LISSTech.DrainCtl.cab"
            EmbedCab="yes" />

        <!-- MSI properties for unattended install -->
        <Property Id="INSTALL_MODE" Value="standalone" Secure="yes" />
        <Property Id="WEBHOOK_URL" Secure="yes" />
        <Property Id="NTFY_URL" Secure="yes" />
        <Property Id="DASHBOARD_URL" Secure="yes" />
        <Property Id="DASHBOARD_PORT" Value="49470" Secure="yes" />
        <Property Id="DASHBOARD_GROUP" Value="Domain Admins" Secure="yes" />
        <Property Id="GRACE_PERIOD" Value="60" Secure="yes" />
        <Property Id="ENABLE_PERF" Value="1" Secure="yes" />
        <Property Id="ENABLE_RFX" Value="1" Secure="yes" />
        <Property Id="POLL_INTERVAL" Value="60" Secure="yes" />
        <Property Id="SESSION_THRESHOLD" Value="80" Secure="yes" />
        <Property Id="LOG_FILE_LEVEL" Value="info" Secure="yes" />
        <Property Id="LOG_EVENT_LEVEL" Value="info" Secure="yes" />
        <Property Id="DASHBOARD_ONLY" Value="0" Secure="yes" />
        <Property Id="AUTODISCOVER" Value="1" Secure="yes" />

        <!-- UI: custom wizard with install mode selection -->
        <ui:WixUI Id="DrainCtlUI" />
        <WixVariable Id="WixUILicenseRtf" Value="resources\license.rtf" />
        <WixVariable Id="WixUIDialogBmp" Value="resources\dialog.bmp" />
        <WixVariable Id="WixUIBannerBmp" Value="resources\banner.bmp" />

        <UI>
            <ComboBox Property="INSTALL_MODE">
                <ListItem Value="standalone" Text="Standalone — monitor only" />
                <ListItem Value="dashboard" Text="Dashboard — run dashboard server" />
                <ListItem Value="registration" Text="Registration — register with dashboard" />
            </ComboBox>
        </UI>

        <!--
            Custom actions via WixQuietExec — no console window.
            Split into two calls to stay under the 255-char CustomAction.Target limit (ICE03).
            ConfigureAction: core settings (mode, grace, perf, dashboard server).
            ConfigureNotifyAction: notification URLs (webhook, ntfy, dashboard-url).
            The second call loads the config saved by the first and layers on URL flags.
        -->
        <SetProperty Id="ConfigureAction" Before="ConfigureAction" Sequence="execute"
            Value="&quot;[BinFolder]drainctl.exe&quot; configure --mode=[INSTALL_MODE] --grace-period=[GRACE_PERIOD] --dashboard-port=[DASHBOARD_PORT] --dashboard-group=&quot;[DASHBOARD_GROUP]&quot; --perf-enabled=[ENABLE_PERF] --perf-rfx=[ENABLE_RFX]" />
        <CustomAction Id="ConfigureAction"
            DllEntry="WixQuietExec"
            Execute="commit"
            Impersonate="no"
            Return="check"
            BinaryRef="Wix4UtilCA_X64" />

        <SetProperty Id="ConfigureNotifyAction" Before="ConfigureNotifyAction" Sequence="execute"
            Value="&quot;[BinFolder]drainctl.exe&quot; configure --mode=[INSTALL_MODE] --dashboard-url=[DASHBOARD_URL] --webhook-url=[WEBHOOK_URL] --ntfy-url=[NTFY_URL] --poll-interval=[POLL_INTERVAL] --session-warning-threshold=[SESSION_THRESHOLD]" />
        <CustomAction Id="ConfigureNotifyAction"
            DllEntry="WixQuietExec"
            Execute="commit"
            Impersonate="no"
            Return="check"
            BinaryRef="Wix4UtilCA_X64" />

        <SetProperty Id="ConfigureExtrasAction" Before="ConfigureExtrasAction" Sequence="execute"
            Value="&quot;[BinFolder]drainctl.exe&quot; configure --mode=[INSTALL_MODE] --log-file-level=[LOG_FILE_LEVEL] --log-event-level=[LOG_EVENT_LEVEL] --dashboard-only=[DASHBOARD_ONLY]" />
        <CustomAction Id="ConfigureExtrasAction"
            DllEntry="WixQuietExec"
            Execute="commit"
            Impersonate="no"
            Return="check"
            BinaryRef="Wix4UtilCA_X64" />

        <!-- ETW provider: um before im on install (clears stale registration from
             previous installs or major upgrades), um on uninstall. -->
        <SetProperty Id="CleanETWProvider" Before="CleanETWProvider" Sequence="execute"
            Value="&quot;[SystemFolder]wevtutil.exe&quot; um &quot;[BinFolder]drainctl.man&quot;" />
        <CustomAction Id="CleanETWProvider"
            DllEntry="WixQuietExec"
            Execute="commit"
            Impersonate="no"
            Return="ignore"
            BinaryRef="Wix4UtilCA_X64" />

        <SetProperty Id="RegisterETWProvider" Before="RegisterETWProvider" Sequence="execute"
            Value="&quot;[SystemFolder]wevtutil.exe&quot; im &quot;[BinFolder]drainctl.man&quot;" />
        <CustomAction Id="RegisterETWProvider"
            DllEntry="WixQuietExec"
            Execute="commit"
            Impersonate="no"
            Return="ignore"
            BinaryRef="Wix4UtilCA_X64" />

        <SetProperty Id="UnregisterETWProvider" Before="UnregisterETWProvider" Sequence="execute"
            Value="&quot;[SystemFolder]wevtutil.exe&quot; um &quot;[BinFolder]drainctl.man&quot;" />
        <CustomAction Id="UnregisterETWProvider"
            DllEntry="WixQuietExec"
            Execute="deferred"
            Impersonate="no"
            Return="ignore"
            BinaryRef="Wix4UtilCA_X64" />

        <SetProperty Id="AddEventLogReaders" Before="AddEventLogReaders" Sequence="execute"
            Value="&quot;[BinFolder]drainctl.exe&quot; service grant-eventlog" />
        <CustomAction Id="AddEventLogReaders"
            DllEntry="WixQuietExec"
            Execute="commit"
            Impersonate="no"
            Return="ignore"
            BinaryRef="Wix4UtilCA_X64" />

        <SetProperty Id="RestartService" Before="RestartService" Sequence="execute"
            Value="&quot;[BinFolder]drainctl.exe&quot; service restart" />
        <CustomAction Id="RestartService"
            DllEntry="WixQuietExec"
            Execute="commit"
            Impersonate="no"
            Return="ignore"
            BinaryRef="Wix4UtilCA_X64" />

        <InstallExecuteSequence>
            <Custom Action="ConfigureAction"
                After="InstallFiles"
                Condition="NOT REMOVE AND NOT WIX_UPGRADE_DETECTED" />
            <Custom Action="ConfigureNotifyAction"
                After="ConfigureAction"
                Condition="NOT REMOVE AND NOT WIX_UPGRADE_DETECTED" />
            <Custom Action="ConfigureExtrasAction"
                After="ConfigureNotifyAction"
                Condition="NOT REMOVE AND NOT WIX_UPGRADE_DETECTED" />
            <Custom Action="CleanETWProvider"
                After="ConfigureExtrasAction"
                Condition="NOT REMOVE" />
            <Custom Action="RegisterETWProvider"
                After="CleanETWProvider"
                Condition="NOT REMOVE" />
            <Custom Action="UnregisterETWProvider"
                After="InstallInitialize"
                Condition="REMOVE" />
            <Custom Action="AddEventLogReaders"
                After="RegisterETWProvider"
                Condition="NOT REMOVE" />
            <Custom Action="RestartService"
                After="AddEventLogReaders"
                Condition="NOT REMOVE" />
        </InstallExecuteSequence>

        <Feature Id="Main">
            <ComponentGroupRef Id="AllComponents" />
        </Feature>
    </Package>

    <!-- ── Binaries + Service: Program Files\LISS Technologies\LISSTech DrainCtl\bin ── -->
    <Fragment>
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="LISSTechFolder" Name="LISS Technologies">
                <Directory Id="INSTALLFOLDER" Name="LISSTech DrainCtl">
                    <Directory Id="BinFolder" Name="bin" />
                </Directory>
            </Directory>
        </StandardDirectory>

        <!-- drainctl.exe: CLI + service binary, PATH entry -->
        <Component Id="MainExe" Directory="BinFolder"
            Guid="d4e2f1a0-8c37-4b5e-9d6a-1f3c7e2b8a4d">
            <File Id="drainctl.exe"
                Source="..\dist\LISSTech.DrainCtl\bin\drainctl.exe"
                KeyPath="yes" />
            <Environment Id="PATH"
                Name="PATH"
                Value="[BinFolder]"
                Permanent="no"
                Part="last"
                Action="set"
                System="yes" />
            <ServiceInstall Id="DrainCtlService"
                Name="DrainCtl"
                DisplayName="Remote Desktop Drain Mode Monitor"
                Description="Monitors Remote Desktop Session Host drain mode (TSServerDrainMode) and maintains an audit trail of state changes."
                Type="ownProcess"
                Start="auto"
                ErrorControl="normal"
                Arguments="service run"
                Account="LocalSystem" />
            <ServiceControl Id="DrainCtlServiceControl"
                Name="DrainCtl"
                Start="install"
                Stop="both"
                Remove="uninstall"
                Wait="yes" />
        </Component>

        <!-- drainctl.dll: P/Invoke target for PS module loaded from bin/ -->
        <Component Id="MainDll" Directory="BinFolder"
            Guid="5e6ed7b5-73a2-4ed3-ae86-ae1e9eade61c">
            <File Id="drainctl.dll"
                Source="..\dist\LISSTech.DrainCtl\bin\drainctl.dll"
                KeyPath="yes" />
        </Component>

        <!-- ETW provider: manifest + resource DLL for manifest-based ETW -->
        <Component Id="ETWProvider" Directory="BinFolder"
            Guid="6d88631f-f074-4125-9399-28a349a45bea">
            <!-- Resource DLL referenced by the manifest (messageFileName / resourceFileName) -->
            <File Id="drainctl_msg.dll"
                Source="..\assets\drainctl-msg.dll"
                Name="drainctl-msg.dll"
                KeyPath="yes" />
            <!-- ETW instrumentation manifest — registered via wevtutil im/um -->
            <File Id="drainctl_man"
                Source="..\assets\drainctl.man"
                Name="drainctl.man" />
            <!-- Remove legacy custom "DrainCtl" event log source on upgrade -->
            <RemoveRegistryKey Root="HKLM"
                Key="SYSTEM\CurrentControlSet\Services\EventLog\DrainCtl\DrainCtl"
                Action="removeOnInstall" />
            <!-- Remove legacy Application log source on upgrade -->
            <RemoveRegistryKey Root="HKLM"
                Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\DrainCtl"
                Action="removeOnInstall" />
        </Component>
    </Fragment>

    <!-- ── ProgramData: LISS Technologies\LISSTech DrainCtl ────────────────── -->
    <Fragment>
        <StandardDirectory Id="CommonAppDataFolder">
            <Directory Id="ProgramDataLISSTech" Name="LISS Technologies">
                <Directory Id="DATADIRECTORY" Name="LISSTech DrainCtl" />
            </Directory>
        </StandardDirectory>

        <Component Id="DataDirectory" Directory="DATADIRECTORY"
            Guid="0c2afad8-e85a-4a79-b484-d3e51ebd6fea">
            <CreateFolder>
                <Permission User="SYSTEM" GenericAll="yes" />
                <Permission User="Administrators" GenericAll="yes" />
                <Permission User="SERVICE" GenericAll="yes" />
                <Permission User="Users" GenericRead="yes" GenericExecute="yes" />
            </CreateFolder>
        </Component>
    </Fragment>

    <!-- ── PowerShell Module: WindowsPowerShell\Modules\LISSTech.DrainCtl ── -->
    <Fragment>
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="WindowsPowerShellFolder" Name="WindowsPowerShell">
                <Directory Id="PSModulesFolder" Name="Modules">
                    <Directory Id="DrainCtlModuleFolder" Name="LISSTech.DrainCtl" />
                </Directory>
            </Directory>
        </StandardDirectory>

        <Component Id="PSModule" Directory="DrainCtlModuleFolder"
            Guid="cef702c3-0c59-4e9a-99c7-cd196ab5db23">
            <File Id="DrainCtl.psd1"
                Source="..\dist\LISSTech.DrainCtl\LISSTech.DrainCtl.psd1"
                KeyPath="yes" />
            <File Id="DrainCtl.psm1"
                Source="..\dist\LISSTech.DrainCtl\LISSTech.DrainCtl.psm1" />
            <File Id="drainctl_ps.dll"
                Source="..\dist\LISSTech.DrainCtl\bin\drainctl.dll"
                Name="drainctl.dll" />
        </Component>
    </Fragment>

    <!-- ── Default config.json in ProgramData ──────────────────────────────── -->
    <Fragment>
        <Component Id="DefaultConfig" Directory="DATADIRECTORY"
            Guid="39697d17-5164-472b-8a1e-533e93d4e4c9"
            NeverOverwrite="yes">
            <File Id="config.json"
                Source="config.json"
                KeyPath="yes" />
        </Component>
    </Fragment>

    <!-- ── EnableLagCounter: makes User Input Delay counter available ────── -->
    <Fragment>
        <Component Id="EnableLagCounter" Directory="DATADIRECTORY"
            Guid="b8f4e2d1-6a3c-4e7f-9b1d-2c5a8f3e7d0b"
            NeverOverwrite="yes">
            <RegistryValue Root="HKLM"
                Key="System\CurrentControlSet\Control\Terminal Server"
                Name="EnableLagCounter"
                Type="integer"
                Value="1"
                KeyPath="yes" />
        </Component>
    </Fragment>

    <!-- ── Firewall rule ─────────────────────────────────────────────────── -->
    <!-- Always installed — an allow rule for a closed port is a no-op.
         Conditional install broke upgrades: INSTALL_MODE defaults to
         "standalone" and config actions are skipped on upgrade, so the
         condition evaluated false and the rule was removed. -->
    <Fragment>
        <Component Id="FirewallRule" Directory="BinFolder"
            Guid="a1b2c3d4-5e6f-7a8b-9c0d-e1f2a3b4c5d6">
            <fw:FirewallException Id="DashboardTcpIn"
                Name="Remote Desktop Drain Monitor (TCP-In)"
                Scope="any"
                Protocol="tcp"
                Port="[DASHBOARD_PORT]"
                Profile="domain"
                Description="Allows inbound TCP connections to the LISSTech DrainCtl dashboard."
                Grouping="Remote Desktop Drain Monitor" />
        </Component>
    </Fragment>

    <!-- ── Component Group ─────────────────────────────────────────────────── -->
    <Fragment>
        <ComponentGroup Id="AllComponents">
            <ComponentRef Id="MainExe" />
            <ComponentRef Id="MainDll" />
            <ComponentRef Id="ETWProvider" />
            <ComponentRef Id="DefaultConfig" />
            <ComponentRef Id="DataDirectory" />
            <ComponentRef Id="PSModule" />
            <ComponentRef Id="FirewallRule" />
            <ComponentRef Id="EnableLagCounter" />
        </ComponentGroup>
    </Fragment>
</Wix>
