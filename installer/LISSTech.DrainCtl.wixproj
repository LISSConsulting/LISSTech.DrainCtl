<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>LISSTech.DrainCtl</OutputName>
    <OutputPath>..\dist</OutputPath>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <TargetProfile>Release</TargetProfile>
    <Cultures>;</Cultures>
    <SuppressPdbOutput>true</SuppressPdbOutput>
  </PropertyGroup>
  <PropertyGroup>
    <!-- ProductVersion is injected by `just msi` via -p:ProductVersion=YY.DOY.N
         (computed by scripts/version.ps1). The default lets a bare `dotnet build`
         still produce an MSI, labelled 0.0.0 so it is obviously non-release. -->
    <ProductVersion Condition="'$(ProductVersion)'==''">0.0.0</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
