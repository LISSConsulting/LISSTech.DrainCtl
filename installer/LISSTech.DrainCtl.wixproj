<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <OutputName>LISSTech.DrainCtl</OutputName>
    <OutputPath>..\dist</OutputPath>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <TargetProfile>Release</TargetProfile>
    <Cultures>;</Cultures>
    <SuppressPdbOutput>true</SuppressPdbOutput>
  </PropertyGroup>
  <PropertyGroup>
    <!-- ProductVersion is MSI-specific: scripts/msi-version.ps1 adds a
         major-version epoch so legacy YY.DOY.N packages cannot replace the
         current YY.MM.N line, then adds a per-build revision. AppVersion is
         the git-derived CalVer shown to users in package naming. Defaults
         keep bare dotnet builds obviously non-release. -->
    <ProductVersion Condition="'$(ProductVersion)'==''">0.0.0</ProductVersion>
    <AppVersion Condition="'$(AppVersion)'==''">0.0.0</AppVersion>
    <DefineConstants>ProductVersion=$(ProductVersion);AppVersion=$(AppVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
